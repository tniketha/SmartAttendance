PORT=5000
NODE_ENV=development
DATABASE_URL="mongodb://127.0.0.1:27018/smart_attendance?replicaSet=attendance-local"
# Generate a key: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Set to 1 only when the API is reachable exclusively through one trusted proxy.
TRUST_PROXY_HOPS=0
