PORT=5000
NODE_ENV=development
DATABASE_URL="mongodb://127.0.0.1:27018/smart_attendance?replicaSet=attendance-local"
# Generate three different values using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Empty values use temporary development keys. Production refuses them.
JWT_SECRET=
JWT_REFRESH_SECRET=
QR_TOKEN_SECRET=
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
QR_REFRESH_INTERVAL_SECONDS=20
