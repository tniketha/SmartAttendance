{
  "expo": {
    "name": "SmartAttendance",
    "slug": "smart-attendance",
    "version": "1.0.0",
    "icon": "./assets/brand/app-icon.png",
    "splash": {
      "image": "./assets/brand/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#172554"
    },
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartattendance.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to scan attendance QR codes."
      }
    },
    "android": {
      "package": "com.smartattendance.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#172554"
      },
      "permissions": ["CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/brand/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera access to scan classroom attendance QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
