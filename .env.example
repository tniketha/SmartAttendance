# Physical devices must use your computer's LAN address during development.
# Native release builds require your real HTTPS API endpoint.
# Docker sets /api at build time and resolves it against the current web origin.
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# For Docker, run node docker/setup.cjs to generate five distinct private secrets.
# MongoDB passwords must be URI-safe; generated values are hexadecimal.
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
QR_TOKEN_SECRET=
# Optional Docker settings (defaults bind the web interface to loopback):
# HTTP_PORT=8080
# HTTPS_PORT=8443
# BIND_ADDRESS=127.0.0.1
# SITE_ADDRESS=http://:80
# ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
